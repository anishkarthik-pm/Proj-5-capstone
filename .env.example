# Ooty Trip Planner Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Google Gemini LLM Configuration (Recommended)
# ===========================================
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Provider and Model
NEXT_PUBLIC_LLM_PROVIDER=gemini
# Available models (pick one):
#   - gemini-2.0-flash (recommended - fast and capable)
#   - gemini-1.5-flash (stable, widely available)
#   - gemini-1.5-pro (more capable but slower)
NEXT_PUBLIC_LLM_MODEL=gemini-2.0-flash

# Alternative: Set model via GEMINI_MODEL (takes precedence)
# GEMINI_MODEL=gemini-2.0-flash

# ===========================================
# n8n Workflow Integration (for email functionality)
# ===========================================
# Get this URL from your n8n webhook node (see README for setup)
# NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/ooty-itinerary

# ===========================================
# Alternative LLM Providers (if not using Gemini)
# ===========================================
# Anthropic Claude
# NEXT_PUBLIC_LLM_PROVIDER=anthropic
# NEXT_PUBLIC_LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (legacy support)
# NEXT_PUBLIC_LLM_PROVIDER=openai
# NEXT_PUBLIC_LLM_MODEL=gpt-4-turbo
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Deployment Configuration
# ===========================================
# For Docker deployment
# NODE_ENV=production

# For n8n Docker service (optional)
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=changeme
